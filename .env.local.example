# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# Resend (email)
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=Alubonets <onboarding@resend.dev>
RESEND_TEST_EMAIL=you@example.com

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# App
JWT_SECRET=generate-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=development

# Local testing autofill (disable in production: NEXT_PUBLIC_ENABLE_TEST_ACCOUNTS=false)
NEXT_PUBLIC_ENABLE_TEST_ACCOUNTS=true
# Skip email verification step while testing role logins locally
BYPASS_LOGIN_VERIFICATION=true

# Super Admin + role test passwords (never commit .env.local)
# NEXT_PUBLIC_* copies are required so the login dropdown can autofill in the browser
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=choose-a-strong-local-password
SEED_AUTH_PASSWORD=choose-a-strong-local-password
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_SUPER_ADMIN_PASSWORD=choose-a-strong-local-password
NEXT_PUBLIC_SEED_AUTH_PASSWORD=choose-a-strong-local-password
# SUPER_ADMIN_FULL_NAME=Your Name

# Playwright (optional)
# E2E_MEMBER_EMAIL=member@alubonets.com
# E2E_MEMBER_PASSWORD=
# E2E_ADMIN_EMAIL=admin@alubonets.com
# E2E_ADMIN_PASSWORD=
# E2E_RUN=1

# Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@your-sentry-host/your-project-id
SENTRY_DSN=https://your-public-key@your-sentry-host/your-project-id
# Required only for production source-map uploads. Keep server-side and secret.
SENTRY_AUTH_TOKEN=

# Cloudflare Turnstile — temporarily unused on contact form; keep keys ready to re-enable
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# App cron (NOT database backups — Supabase owns backups).
# Sync: GET /api/cron/stage4-maintenance with Bearer CRON_SECRET
# Retention: GET /api/cron/purge-audit with Bearer CRON_SECRET
# Local: npm run cron:maintenance | npm run cron:purge-audit
# Netlify schedules + GitHub Actions workflow cron.yml also call these.
AUDIT_RETENTION_MONTHS=18
CRON_SECRET=change-me-to-a-long-random-string
# Optional override for scheduled callers
# CRON_BASE_URL=https://your-production-domain.com
