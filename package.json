{
  "name": "alubonets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/validate-env.mjs",
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3001",
    "dev:webpack": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3001",
    "prebuild": "node scripts/validate-env.mjs && prisma generate",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run test",
    "db:push": "node scripts/prisma-with-env.mjs db push",
    "db:pull": "node scripts/prisma-with-env.mjs db pull",
    "db:studio": "node scripts/prisma-with-env.mjs studio",
    "db:generate": "node scripts/prisma-with-env.mjs generate",
    "db:migrate": "node scripts/prisma-with-env.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma-with-env.mjs migrate deploy",
    "db:migrate:status": "node scripts/prisma-with-env.mjs migrate status",
    "db:test": "node scripts/test-db-connections.mjs",
    "db:seed": "node scripts/prisma-with-env.mjs db seed",
    "db:bootstrap-auth": "node scripts/bootstrap-auth-users.mjs",
    "db:purge-audit": "node scripts/purge-audit-logs.mjs",
    "icons:subset": "python scripts/subset-icons.py",
    "cron:maintenance": "node scripts/run-cron.mjs stage4-maintenance",
    "cron:purge-audit": "node scripts/run-cron.mjs purge-audit",
    "icons:generate": "node scripts/generate-favicons.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "chart.js": "^4.4.6",
    "docx": "^9.0.3",
    "jose": "^6.2.3",
    "next": "^15.5.28",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
