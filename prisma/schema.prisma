generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EXECUTIVE
  TREASURER
  SECRETARY
  ORGANIZER
  MEMBER
}

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MemberCategory {
  ORDINARY
  COMMITTEE_MEMBER
  ADMIN
  EXECUTIVE
  TREASURER
  SECRETARY
  ORGANIZER
  MEMBER
}

enum EducationLevel {
  PRIMARY
  SECONDARY
  CERTIFICATE
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

enum IdentityVerificationStatus {
  NOT_REVIEWED
  VERIFIED
  REJECTED
}

enum ContactStatus {
  UNREAD
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ContentGroup {
  HOME
  ABOUT
  CONTACT
  FOOTER
  ACTIVITIES
  SOCIAL_LINKS
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum ProjectCommentStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum WelfareStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
}

enum LoanGuarantorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum LoanLedgerKind {
  DISBURSEMENT
  REPAYMENT
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  OTHER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  RECONCILED
  REVERSED
}
enum ReconciliationStatus {
  UNRECONCILED
  MATCHED
  RECONCILED
  DISPUTED
}
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}
enum TransactionType {
  CONTRIBUTION
  EXPENSE
  DISBURSEMENT
  ADJUSTMENT
  REVERSAL
  TRANSFER
  OPENING_BALANCE
}
enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}
enum PeriodStatus {
  OPEN
  CLOSED
}
enum ObligationStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  WAIVED
}
enum PaymentEventStatus {
  UNMATCHED
  MATCHED
  DUPLICATE
  IGNORED
}

enum MeetingStatus {
  DRAFT
  NOTICE
  PENDING_APPROVAL
  FINAL
}

enum DocumentAccessLevel {
  PUBLIC
  MEMBERS
  SELECTED_ROLES
  ADMIN_SECRETARY
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  EXPIRED
}

enum MeetingAudienceType {
  ALL_MEMBERS
  SELECTED_ROLES
  SELECTED_MEMBERS
  MIXED
}

enum ActionPointStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum EventAudienceType {
  PUBLIC
  ALL_MEMBERS
  SELECTED_ROLES
  SELECTED_MEMBERS
}

enum EventRsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum AnnouncementDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AnnouncementPublishStatus {
  DRAFT
  SCHEDULED
  SENT
}

model User {
  id              String       @id @default(cuid())
  authUserId      String?      @unique
  email           String       @unique
  fullName        String
  phone           String?
  location        String?
  role            Role         @default(MEMBER)
  status          MemberStatus @default(PENDING)
  isSuperAdmin    Boolean      @default(false)
  dashboardAccess Role[]       @default([])
  avatarUrl       String?
  membershipNumber String?     @unique
  approvalNotes     String?
  rejectionReason  String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  identityVerificationStatus IdentityVerificationStatus @default(NOT_REVIEWED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contributions        Contribution[]
  welfareRequests      WelfareRequest[]
  auditLogs            AuditLog[]
  announcements        Announcement[]
  announcementReceipts AnnouncementReceipt[]
  documents            Document[]
  meetings             Meeting[]      @relation("MeetingRecorder")
  galleryPhotos        GalleryPhoto[]
  emailLogs            EmailLog[]
  memberProfile        MemberProfile?
  consentRecords       ConsentRecord[]
  loginEvents          LoginEvent[]
  assignedContacts     ContactSubmission[] @relation("ContactAssignee")
  contactReplies       ContactReply[]
  editedContent        PublicContentVersion[]
  committeeProfilesEdited CommitteeProfile[] @relation("CommitteeEditor")
  createdFinancialTransactions FinancialTransaction[] @relation("TransactionCreator")
  approvedFinancialTransactions FinancialTransaction[] @relation("TransactionApprover")
  contributionObligations MemberContributionObligation[]
  reconciliationsPerformed Reconciliation[] @relation("ReconciledBy")
  financialDocuments SupportingDocument[] @relation("DocumentUploader")
  documentDownloads DocumentDownload[]
  meetingInvitations MeetingInvitation[]
  ownedActionPoints MeetingActionPoint[] @relation("ActionPointOwner")
  createdActionPoints MeetingActionPoint[] @relation("ActionPointCreator")
  createdDecisions MeetingDecision[]
  approvedMeetings Meeting[] @relation("MeetingApprover")
  projectResponsibilities ProjectResponsible[]
  projectComments ProjectComment[] @relation("ProjectCommentAuthor")
  moderatedProjectComments ProjectComment[] @relation("ProjectCommentModerator")
  projectInvestments ProjectInvestment[] @relation("ProjectInvestor")
  recordedProjectInvestments ProjectInvestment[] @relation("ProjectInvestmentRecorder")
  projectUpdates ProjectUpdate[]
  eventInvitations EventInvitation[]
  eventRsvps EventRSVP[]
  eventAttendances EventAttendance[] @relation("EventAttendee")
  recordedEventAttendances EventAttendance[] @relation("EventAttendanceRecorder")
  eventCostsRecorded EventCost[]
  loanApplications LoanApplication[] @relation("LoanApplicant")
  loanReviews LoanApplication[] @relation("LoanTreasurerReviewer")
  loanDecisions LoanApplication[] @relation("LoanDecider")
  loanGuarantees LoanGuarantor[]

  @@map("users")
}

model MemberProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender                Gender?
  dateOfBirth           DateTime?
  address               String?
  familyBranch          String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  profession            String?
  skills                String?
  educationLevel        EducationLevel?
  achievements          String?
  mentorshipArea        String?
  interests             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  memberCategory        MemberCategory?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([familyBranch])
  @@index([memberCategory])
  @@map("member_profiles")
}

model ConsentRecord {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion    String
  privacyVersion  String
  acceptedAt      DateTime @default(now())
  ipAddress       String?
  userAgent       String?

  @@index([userId, acceptedAt])
  @@map("consent_records")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_events")
}

model RateLimit {
  id           String   @id @default(cuid())
  key          String   @unique
  attempts     Int      @default(0)
  windowStart  DateTime @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime @updatedAt

  @@map("rate_limits")
}

model MembershipSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("membership_sequences")
}

model Contribution {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  description   String?
  category      String?
  paymentMethod PaymentMethod @default(CASH)
  receivedBy    String?
  statementRef  String?
  paidAt        DateTime      @default(now())
  mpesaRef      String?
  createdAt     DateTime      @default(now())
  status        TransactionStatus @default(CONFIRMED)
  reconciliationStatus ReconciliationStatus @default(UNRECONCILED)
  reconciledAt  DateTime?
  correctionReason String?
  sourceAccountId String?
  sourceAccount FinancialAccount? @relation(fields: [sourceAccountId], references: [id], onDelete: SetNull)
  categoryId    String?
  transactionCategory TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      ContributionCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  financialTransactionId String? @unique
  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)
  contributionPeriod String?
  reversedById String?
  reversedBy   Contribution? @relation("ContributionReversal", fields: [reversedById], references: [id], onDelete: SetNull)
  reverses     Contribution[] @relation("ContributionReversal")
  supportingDocuments SupportingDocument[]

  @@index([userId])
  @@index([paidAt])
  @@index([status, reconciliationStatus])
  @@index([campaignId, userId])
  @@map("contributions")
}

model FinancialAccount {
  id String @id @default(cuid())
  code String @unique
  name String
  type AccountType
  description String?
  restricted Boolean @default(false)
  active Boolean @default(true)
  entries LedgerEntry[]
  sourceContributions Contribution[]
  paymentEvents PaymentEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("financial_accounts")
}

model TransactionCategory {
  id String @id @default(cuid())
  code String @unique
  name String
  type CategoryType
  description String?
  requiresEvidence Boolean @default(false)
  active Boolean @default(true)
  contributions Contribution[]
  campaigns ContributionCampaign[]
  transactions FinancialTransaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("transaction_categories")
}

model AccountingPeriod {
  id String @id @default(cuid())
  year Int
  month Int
  startsAt DateTime
  endsAt DateTime
  status PeriodStatus @default(OPEN)
  closedAt DateTime?
  closedBy String?
  transactions FinancialTransaction[]
  reconciliations Reconciliation[]
  @@unique([year, month])
  @@index([status, startsAt])
  @@map("accounting_periods")
}

model FinancialTransaction {
  id String @id @default(cuid())
  transactionNumber String @unique
  type TransactionType
  status TransactionStatus @default(PENDING)
  amount Decimal @db.Decimal(14, 2)
  description String
  occurredAt DateTime
  providerReference String? @unique
  correctionReason String?
  categoryId String?
  category TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  periodId String
  period AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdById String
  createdBy User @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy User? @relation("TransactionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  confirmedAt DateTime?
  reconciledAt DateTime?
  reversedAt DateTime?
  originalTransactionId String?
  originalTransaction FinancialTransaction? @relation("TransactionReversal", fields: [originalTransactionId], references: [id], onDelete: Restrict)
  reversingTransactions FinancialTransaction[] @relation("TransactionReversal")
  entries LedgerEntry[]
  contribution Contribution?
  expense Expense?
  disbursement Disbursement?
  adjustment Adjustment?
  reconciliation Reconciliation?
  supportingDocuments SupportingDocument[]
  loanLedgerLinks LoanLedgerLink[]
  createdAt DateTime @default(now())
  @@index([occurredAt, status])
  @@index([categoryId, occurredAt])
  @@map("financial_transactions")
}

model LedgerEntry {
  id String @id @default(cuid())
  transactionId String
  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId String
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)
  memo String?
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model ContributionCampaign {
  id String @id @default(cuid())
  title String
  description String?
  targetAmount Decimal @db.Decimal(14, 2)
  categoryId String
  category TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  startsAt DateTime
  dueAt DateTime?
  active Boolean @default(true)
  createdById String
  contributions Contribution[]
  obligations MemberContributionObligation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, startsAt])
  @@map("contribution_campaigns")
}

model MemberContributionObligation {
  id String @id @default(cuid())
  campaignId String
  campaign ContributionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetAmount Decimal @db.Decimal(14, 2)
  status ObligationStatus @default(OUTSTANDING)
  waivedReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([campaignId, userId])
  @@index([userId, status])
  @@map("member_contribution_obligations")
}

model PaymentEvent {
  id String @id @default(cuid())
  provider String
  providerReference String @unique
  amount Decimal @db.Decimal(14, 2)
  phone String?
  payerName String?
  receivedAt DateTime
  rawPayload Json?
  status PaymentEventStatus @default(UNMATCHED)
  matchedUserId String?
  matchedContributionId String?
  sourceAccountId String?
  sourceAccount FinancialAccount? @relation(fields: [sourceAccountId], references: [id], onDelete: SetNull)
  reconciliation Reconciliation?
  createdAt DateTime @default(now())
  @@index([status, receivedAt])
  @@index([phone, receivedAt])
  @@map("payment_events")
}

model Reconciliation {
  id String @id @default(cuid())
  transactionId String @unique
  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  paymentEventId String? @unique
  paymentEvent PaymentEvent? @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)
  periodId String
  period AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  notes String
  reconciledById String
  reconciledBy User @relation("ReconciledBy", fields: [reconciledById], references: [id], onDelete: Restrict)
  reconciledAt DateTime @default(now())
  @@index([reconciledAt])
  @@map("reconciliations")
}

model Expense {
  id String @id @default(cuid())
  transactionId String @unique
  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  payee String
  purpose String
  approvalRequired Boolean @default(false)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  eventId String?
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@index([projectId])
  @@index([eventId])
  @@map("expenses")
}

model Disbursement {
  id String @id @default(cuid())
  transactionId String @unique
  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  beneficiary String
  purpose String
  welfareRequestId String?
  @@map("disbursements")
}

model Adjustment {
  id String @id @default(cuid())
  transactionId String @unique
  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  reason String
  oldValue Json?
  newValue Json?
  @@map("adjustments")
}

model SupportingDocument {
  id String @id @default(cuid())
  transactionId String?
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  contributionId String?
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  title String
  fileUrl String
  mimeType String
  uploadedById String
  uploadedBy User @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([transactionId])
  @@map("supporting_documents")
}

model WelfareRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float?
  status      WelfareStatus @default(PENDING)
  reviewNote  String?
  categoryId  String?
  category    WelfareCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([categoryId])
  @@map("welfare_requests")
}

model Project {
  id                    String        @id @default(cuid())
  title                 String
  description           String
  status                ProjectStatus @default(UPCOMING)
  imageUrl              String?
  progress              Int           @default(0)
  startDate             DateTime?
  endDate               DateTime?
  budgetKes             Decimal       @default(0) @db.Decimal(14, 2)
  fundingTargetKes      Decimal       @default(0) @db.Decimal(14, 2)
  actualExpenditureKes  Decimal       @default(0) @db.Decimal(14, 2)
  categoryId            String?
  category              ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  responsibles ProjectResponsible[]
  comments     ProjectComment[]
  investments  ProjectInvestment[]
  milestones   ProjectMilestone[]
  updates      ProjectUpdate[]
  documents    ProjectDocument[]
  expenses     Expense[]

  @@index([categoryId])
  @@map("projects")
}

model ProjectResponsible {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_responsibles")
}

model ProjectComment {
  id             String               @id @default(cuid())
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                 @relation("ProjectCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  status         ProjectCommentStatus @default(PENDING)
  moderatedById  String?
  moderatedBy    User?                @relation("ProjectCommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt    DateTime?
  moderationNote String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([projectId, status])
  @@index([authorId])
  @@map("project_comments")
}

model ProjectInvestment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ProjectInvestor", fields: [userId], references: [id], onDelete: Restrict)
  amount       Decimal  @db.Decimal(14, 2)
  investedAt   DateTime @default(now())
  notes        String?
  recordedById String
  recordedBy   User     @relation("ProjectInvestmentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([projectId, investedAt])
  @@index([userId])
  @@map("project_investments")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, position])
  @@map("project_milestones")
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([projectId, publishedAt])
  @@map("project_updates")
}

model ProjectDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([projectId, documentId])
  @@index([documentId])
  @@map("project_documents")
}

model GalleryPhoto {
  id         String    @id @default(cuid())
  url        String
  caption    String?
  category   String?
  isPublic   Boolean   @default(false)
  approvedAt DateTime?
  uploadedBy String?
  uploader   User?     @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  uploadedAt DateTime  @default(now())

  @@map("gallery_photos")
}

model Announcement {
  id            String                    @id @default(cuid())
  title         String
  content       String
  imageUrl      String?
  authorId      String
  author        User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  broadcast     Boolean                   @default(true)
  publishedAt   DateTime                  @default(now())
  expiresAt     DateTime?
  createdAt     DateTime                  @default(now())
  emailSentAt   DateTime?
  status        AnnouncementPublishStatus @default(SENT)
  scheduledFor  DateTime?
  audienceRoles Role[]                    @default([])
  familyBranch  String?
  templateKey   String?

  receipts AnnouncementReceipt[]

  @@index([status, scheduledFor])
  @@map("announcements")
}

model AnnouncementReceipt {
  id             String                     @id @default(cuid())
  announcementId String
  announcement   Announcement               @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime                   @default(now())
  emailStatus    AnnouncementDeliveryStatus @default(PENDING)
  emailError     String?
  emailSentAt    DateTime?
  retryCount     Int                        @default(0)

  @@unique([announcementId, userId])
  @@index([emailStatus, retryCount])
  @@map("announcement_receipts")
}

model AnnouncementTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  bodyHtml  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcement_templates")
}

model Event {
  id                   String            @id @default(cuid())
  title                String
  description          String?
  location             String?
  startsAt             DateTime
  endsAt               DateTime?
  imageUrl             String?
  isPublic             Boolean           @default(true)
  audienceType         EventAudienceType @default(PUBLIC)
  audienceRoles        Role[]            @default([])
  capacity             Int?
  rsvpDeadlineAt       DateTime?
  budgetKes            Decimal           @default(0) @db.Decimal(14, 2)
  actualCostKes        Decimal           @default(0) @db.Decimal(14, 2)
  reminderOffsetsHours Int[]             @default([])
  remindersSent        Json?
  reportBody           String?
  reportPublishedAt    DateTime?
  galleryPhotoIds      String[]          @default([])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  invitations EventInvitation[]
  rsvps       EventRSVP[]
  attendance  EventAttendance[]
  attachments EventAttachment[]
  costs       EventCost[]
  expenses    Expense[]

  @@index([startsAt])
  @@index([isPublic, startsAt])
  @@map("events")
}

model EventInvitation {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([eventId, userId])
  @@map("event_invitations")
}

model EventRSVP {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      EventRsvpStatus
  note        String?
  respondedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@map("event_rsvps")
}

model EventAttendance {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("EventAttendee", fields: [userId], references: [id], onDelete: Cascade)
  present      Boolean  @default(true)
  recordedById String
  recordedBy   User     @relation("EventAttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_attendances")
}

model EventAttachment {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  storagePath String?
  mimeType    String?
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@map("event_attachments")
}

model EventCost {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label        String
  amount       Decimal  @db.Decimal(14, 2)
  notes        String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@map("event_costs")
}

model Document {
  id                String              @id @default(cuid())
  title             String
  description       String?
  fileUrl           String
  storagePath       String?
  mimeType          String?
  category          String?
  categoryId        String?
  categoryRecord    DocumentCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accessLevel       DocumentAccessLevel @default(MEMBERS)
  allowedRoles      Role[]              @default([])
  version           Int                 @default(1)
  versionGroupId    String              @default(cuid())
  previousVersionId String?             @unique
  previousVersion   Document?           @relation("DocumentVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion       Document?           @relation("DocumentVersions")
  status            DocumentStatus      @default(DRAFT)
  effectiveAt       DateTime?
  expiresAt         DateTime?
  archivedAt        DateTime?
  uploadedBy        String
  uploader          User                @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  uploadedAt        DateTime            @default(now())
  downloads         DocumentDownload[]
  projectLinks      ProjectDocument[]

  publishedMeeting Meeting?

  @@index([versionGroupId, version])
  @@index([status, accessLevel])
  @@index([categoryId])
  @@map("documents")
}

model DocumentCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  documents Document[]
  @@map("document_categories")
}

model DocumentDownload {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  downloadedAt DateTime @default(now())
  @@index([documentId, downloadedAt])
  @@map("document_downloads")
}

model Meeting {
  id                  String        @id @default(cuid())
  title               String
  agenda              String?
  minutes             String?
  opening             String?
  location            String?
  attendees           String?
  membersAbsent       String?
  membersApology      String?
  resolutions         String?
  aob                 String?
  nextMeetingAt       DateTime?
  status              MeetingStatus @default(DRAFT)
  heldAt              DateTime
  attendance          Int           @default(0)
  recordedBy          String
  recorder            User          @relation("MeetingRecorder", fields: [recordedBy], references: [id], onDelete: Cascade)
  noticeBody          String?
  noticeSentAt        DateTime?
  audienceType        MeetingAudienceType @default(ALL_MEMBERS)
  audienceRoles       Role[]        @default([])
  approvedById        String?
  approvedBy          User?         @relation("MeetingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  minutesVersion      Int           @default(1)
  publishedDocumentId String?       @unique
  publishedDocument   Document?     @relation(fields: [publishedDocumentId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  invitations         MeetingInvitation[]
  agendaItems         MeetingAgendaItem[]
  actionPoints        MeetingActionPoint[]
  decisions           MeetingDecision[]
  versions            MeetingVersion[]

  @@map("meetings")
}

model MeetingInvitation {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@unique([meetingId, userId])
  @@map("meeting_invitations")
}

model MeetingAgendaItem {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String?
  @@unique([meetingId, position])
  @@map("meeting_agenda_items")
}

model MeetingActionPoint {
  id          String            @id @default(cuid())
  meetingId   String
  meeting     Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String
  description String?
  ownerId     String
  owner       User              @relation("ActionPointOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  dueAt       DateTime?
  status      ActionPointStatus @default(OPEN)
  createdById String
  createdBy   User              @relation("ActionPointCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([ownerId, status])
  @@map("meeting_action_points")
}

model MeetingDecision {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  reference   String   @unique
  title       String
  decision    String
  decidedAt   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  @@index([decidedAt])
  @@map("meeting_decisions")
}

model MeetingVersion {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  reason      String
  createdById String
  createdAt   DateTime @default(now())
  @@unique([meetingId, version])
  @@map("meeting_versions")
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail   String
  subject   String
  template  String?
  status    String   @default("sent")
  meta      Json?
  createdAt DateTime @default(now())

  @@map("email_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  oldValue  Json?
  newValue  Json?
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  category    String?
  message     String
  emailStatus String    @default("pending")
  readAt      DateTime?
  status      ContactStatus @default(UNREAD)
  assignedToId String?
  assignedTo   User?    @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  spamAt       DateTime?
  retainUntil  DateTime?
  replies      ContactReply[]
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
  @@index([status, createdAt])
  @@index([assignedToId])
  @@map("contact_submissions")
}

model ContactReply {
  id           String @id @default(cuid())
  submissionId String
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sentById     String
  sentBy       User @relation(fields: [sentById], references: [id], onDelete: Restrict)
  subject      String
  body         String
  method       String
  deliveryStatus String @default("recorded")
  sentAt       DateTime @default(now())
  @@index([submissionId, sentAt])
  @@map("contact_replies")
}

model AppSetting {
  key       String @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
  @@map("app_settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@map("feature_flags")
}

model WelfareCategory {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests  WelfareRequest[]
  @@map("welfare_categories")
}

model ProjectCategory {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
  @@map("project_categories")
}

/// Master-data labels for membership classes (distinct from MemberCategory enum on profiles).
model MembershipClass {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("membership_classes")
}

model LoanApplication {
  id             String                @id @default(cuid())
  applicantId    String
  applicant      User                  @relation("LoanApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  amountKes      Decimal               @db.Decimal(14, 2)
  purpose        String
  dueAt          DateTime?
  installmentNotes String?
  notes          String?
  status         LoanApplicationStatus @default(SUBMITTED)
  treasurerNote  String?
  reviewedById   String?
  reviewedBy     User?                 @relation("LoanTreasurerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  decidedById    String?
  decidedBy      User?                 @relation("LoanDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  disbursedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  guarantors  LoanGuarantor[]
  ledgerLinks LoanLedgerLink[]

  @@index([applicantId, status])
  @@index([status, createdAt])
  @@map("loan_applications")
}

model LoanGuarantor {
  id          String              @id @default(cuid())
  loanId      String
  loan        LoanApplication     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      LoanGuarantorStatus @default(PENDING)
  note        String?
  respondedAt DateTime?
  createdAt   DateTime            @default(now())

  @@unique([loanId, userId])
  @@index([userId, status])
  @@map("loan_guarantors")
}

model LoanLedgerLink {
  id            String             @id @default(cuid())
  loanId        String
  loan          LoanApplication    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  kind          LoanLedgerKind
  createdAt     DateTime           @default(now())

  @@unique([transactionId])
  @@index([loanId, kind])
  @@map("loan_ledger_links")
}

model PublicContent {
  id          String @id @default(cuid())
  group       ContentGroup @unique
  status      ContentStatus @default(DRAFT)
  draftData   Json
  publishedData Json?
  publishedAt DateTime?
  versions    PublicContentVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("public_content")
}

model PublicContentVersion {
  id        String @id @default(cuid())
  contentId String
  content   PublicContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  editorId  String
  editor    User @relation(fields: [editorId], references: [id], onDelete: Restrict)
  data      Json
  action    String
  createdAt DateTime @default(now())
  @@index([contentId, createdAt])
  @@map("public_content_versions")
}

model CommitteeProfile {
  id          String @id @default(cuid())
  name        String
  position    String
  biography   String
  photoUrl    String?
  displayOrder Int @default(0)
  termStart   DateTime?
  termEnd     DateTime?
  status      ContentStatus @default(DRAFT)
  editedById  String
  editedBy    User @relation("CommitteeEditor", fields: [editedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, displayOrder])
  @@map("committee_profiles")
}

model EmailVerificationChallenge {
  id        String @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("email_verification_challenges")
}
